part --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label BOOTCTL --active --fixed-size 64 --align 4096

part --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label BOOT_A --fixed-size 192 --align 4096

part --source bootimg-partition --ondisk mmcblk0 --fstype=vfat --label BOOT_B --fixed-size 192 --align 4096


part / --source rootfs --ondisk mmcblk0 --fstype=ext4 --label ROOTFS_A --fixed-size 512 --align 4096 --no-fstab-update

part --source rootfs --ondisk mmcblk0 --fstype=ext4 --label ROOTFS_B --fixed-size 512 --align 4096 --no-fstab-update

part --ondisk mmcblk0 --fstype=ext4 --label DATA --fixed-size 1024 --align 4096

bootloader --ptable msdos
