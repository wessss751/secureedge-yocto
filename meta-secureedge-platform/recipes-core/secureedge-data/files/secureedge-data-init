#!/bin/sh

set -eu
umask 077

DATA_DIR="/data"
RAUC_DIR="$DATA_DIR/rauc"
BOOTSTATE_DIR="$DATA_DIR/secureedge-rauc/bootstate"

fail() {
    echo "secureedge-data-init: $*" >&2
    exit 1
}

awk '
    $2 == "/data" && $3 == "ext4" {
        found = 1
    }
    END {
        exit !found
    }
' /proc/mounts || fail "DATA is not mounted as ext4"

[ ! -L "$DATA_DIR" ] ||
    fail "/data must not be a symlink"

for path in \
    "$RAUC_DIR" \
    "$DATA_DIR/secureedge-rauc" \
    "$BOOTSTATE_DIR"
do
    [ ! -L "$path" ] ||
        fail "Symlink forbidden: $path"
done

mkdir -p "$RAUC_DIR"
mkdir -p "$BOOTSTATE_DIR"

chmod 0700 "$RAUC_DIR"
chmod 0700 "$DATA_DIR/secureedge-rauc"
chmod 0700 "$BOOTSTATE_DIR"


for path in \
    "$DATA_DIR/secureedge" \
    "$DATA_DIR/secureedge/config" \
    "$DATA_DIR/secureedge/identity"
do
    [ ! -L "$path" ] || fail "Symlink forbidden: $path"
done

mkdir -p "$DATA_DIR/secureedge/config"
mkdir -p "$DATA_DIR/secureedge/identity"

chown root:secureedge "$DATA_DIR/secureedge"
chown root:secureedge "$DATA_DIR/secureedge/config"
chown root:secureedge "$DATA_DIR/secureedge/identity"

chmod 0750 "$DATA_DIR/secureedge"
chmod 0750 "$DATA_DIR/secureedge/config"
chmod 0750 "$DATA_DIR/secureedge/identity"

[ ! -L "$DATA_DIR/secureedge-rauc" ] ||
    fail "RAUC transaction path is a symlink"

mkdir -p "$DATA_DIR/secureedge-rauc"
chmod 0700 "$DATA_DIR/secureedge-rauc"


INBOX="$DATA_DIR/secureedge-rauc/inbox"

[ ! -L "$INBOX" ] ||
    fail "RAUC inbox must not be a symlink"

mkdir -p "$INBOX"
chown root:root "$INBOX"
chmod 0700 "$INBOX"

echo "secureedge-data-init: persistent directories ready"
