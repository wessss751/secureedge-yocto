[Unit]
Description=SecureEdge Industrial Gateway Agent
After=network.target

[Service]
Type=simple
Environment=SECUREEDGE_CONFIG=/etc/secureedge/agent.conf
EnvironmentFile=-/etc/secureedge/mqtt-tls.env
ExecStart=/usr/bin/secureedge-agent
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
