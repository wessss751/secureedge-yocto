# SecureEdge device-local systemd environment file (paths only; no private keys).
# Copy during offline provisioning to /etc/secureedge/mqtt-tls.env
# Do not enable until ca.crt, device01.crt, device01.key are installed.
SECUREEDGE_MQTT_TLS=1
SECUREEDGE_MQTT_CA=/etc/secureedge/certs/ca.crt
SECUREEDGE_MQTT_CERT=/etc/secureedge/certs/device01.crt
SECUREEDGE_MQTT_KEY=/etc/secureedge/certs/device01.key
